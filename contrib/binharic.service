# Background layer, controlled with hotkeys (`binharic toggle`, `binharic send toggle`).
#   cp contrib/binharic.service ~/.config/systemd/user/
#   systemctl --user enable --now binharic
[Unit]
Description=Binharic speech layer
Wants=pipewire-pulse.service
After=pipewire.service pipewire-pulse.service

[Service]
ExecStartPre=%h/.local/bin/binharic mic up
ExecStart=%h/.local/bin/binharic listen --passthrough --start-off
# at login PipeWire may not be ready yet: retry calmly instead of giving up
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
